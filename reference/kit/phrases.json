    {"id":"leave_negative_space","action":"多留白，别把画面填满","category":"composition","affects":["bg_complexity","subject_ratio"],"delta_hint":"画面更透气","reason_template":"留白比填满更显高级","condition_hint":"bg_complexity 偏高"},
    {"id":"frame_within_frame","action":"找个门框把主体框住","category":"composition","affects":["bg_complexity"],"delta_hint":"增加层次","reason_template":"框中框能让画面有纵深感","condition_hint":"街拍/建筑"},

    {"id":"clean_background","action":"换到更干净的背景","category":"background","affects":["bg_complexity"],"delta_hint":"背景干扰大幅下降","reason_template":"背景太乱会抢走注意力，先解决背景","condition_hint":"bg_complexity > 0.5"},
    {"id":"remove_clutter","action":"把画面里的杂物挪开","category":"background","affects":["bg_complexity"],"delta_hint":"画面变简洁","reason_template":"这个瓶子/包挡在主体旁边，挪一下就好","condition_hint":"存在明显杂物"},
    {"id":"clean_edge","action":"注意画面边缘有没有穿帮","category":"background","affects":["bg_complexity"],"delta_hint":"避免穿帮","reason_template":"边缘的路人和树枝会破坏画面","condition_hint":"边缘检测到高显著物体"},
    {"id":"change_angle_bg","action":"换个角度避开后面的树","category":"background","affects":["bg_complexity"],"delta_hint":"背景杂物离开主体后方","reason_template":"稍微转个角度，树就不在头上了","condition_hint":"背景物体与主体重叠"},
    {"id":"step_for_separation","action":"让人和背景拉开距离","category":"background","affects":["bg_complexity"],"delta_hint":"主体与背景分离","reason_template":"人离背景远一点，主体会立刻跳出来","condition_hint":"主体与背景贴合"},
    {"id":"blur_background","action":"开大光圈虚化背景","category":"background","affects":["bg_complexity"],"delta_hint":"背景变模糊","reason_template":"虚化是最快的背景清理方式","condition_hint":"有光圈控制能力"}
  ]

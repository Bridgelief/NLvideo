    {"id":"slightly_above","action":"机位比对象略高一点","category":"height","affects":["subject_ratio"],"delta_hint":"轻微俯视，显脸小","reason_template":"略高于视线会显脸小，但不会变形","condition_hint":"人像自拍场景"},
    {"id":"ground_level","action":"贴着地面拍","category":"height","affects":["bg_complexity"],"delta_hint":"极强纵深感","reason_template":"贴地视角能拍出平常看不到的层次","condition_hint":"风光/街拍创意镜头"},

    {"id":"dutch_angle","action":"机身倾斜 10 度","category":"angle","affects":["light_angle","gaze_space"],"delta_hint":"画面产生不安定感","reason_template":"倾斜画面能强化冲突和紧张情绪","condition_hint":"情绪叙事 - 冲突"},
    {"id":"side_45","action":"绕到侧 45 度","category":"angle","affects":["gaze_space","light_angle"],"delta_hint":"轮廓更立体","reason_template":"45 度是最显脸小的角度","condition_hint":"人像"},
    {"id":"front_on","action":"正对着拍","category":"angle","affects":["gaze_space"],"delta_hint":"建立直接交流感","reason_template":"正面镜头让观众觉得被注视","condition_hint":"口播/采访"},
    {"id":"back_view","action":"拍背影","category":"angle","affects":["gaze_space"],"delta_hint":"制造悬念和想象空间","reason_template":"背影让观众把自己代入进去","condition_hint":"情绪叙事 - 孤独"},
    {"id":"over_shoulder","action":"从对象肩膀后面拍","category":"angle","affects":["gaze_space"],"delta_hint":"建立主观视角","reason_template":"越肩镜头能让观众站在角色的位置","condition_hint":"对话场景"},
    {"id":"low_angle_up","action":"从下往上仰拍","category":"angle","affects":["subject_ratio"],"delta_hint":"主体显得高大压迫","reason_template":"仰拍适合表现压迫感和力量","condition_hint":"情绪叙事 - 冲突"},
    {"id":"high_angle_down","action":"从上往下俯拍","category":"angle","affects":["subject_ratio"],"delta_hint":"主体显得弱小","reason_template":"俯拍能表现孤立和无助","condition_hint":"情绪叙事 - 压抑"},

    {"id":"side_light","action":"让光从侧面来","category":"light","affects":["light_angle"],"delta_hint":"明暗分界，立体感强","reason_template":"侧光能拍出轮廓和质感","condition_hint":"人像/产品"},
    {"id":"back_light","action":"转到逆光位置","category":"light","affects":["light_angle"],"delta_hint":"轮廓发光，面部压暗","reason_template":"逆光能拍出金边，情绪更浓","condition_hint":"情绪叙事"},
    {"id":"front_light","action":"面向光源","category":"light","affects":["light_angle"],"delta_hint":"面部均匀明亮","reason_template":"要看清细节，顺光最稳妥","condition_hint":"产品/口播"},
    {"id":"golden_hour","action":"等黄金时刻的光","category":"light","affects":["light_angle"],"delta_hint":"暖色调，长影子","reason_template":"日出日落的光比正午好看得多","condition_hint":"风光/情绪"},
    {"id":"avoid_backlight","action":"避开正对光源","category":"light","affects":["light_angle"],"delta_hint":"面部不再发黑","reason_template":"现在脸在阴影里，换个角度让光打到脸上","condition_hint":"front_light 目标但当前逆光"},
    {"id":"move_to_window","action":"移到窗边","category":"light","affects":["light_angle"],"delta_hint":"柔和自然光","reason_template":"窗边有现成的柔光箱，不用额外设备","condition_hint":"室内拍摄"},
    {"id":"shade_subject","action":"用阴影遮住半张脸","category":"light","affects":["light_angle"],"delta_hint":"神秘感","reason_template":"半明半暗比全亮更有故事","condition_hint":"情绪叙事"},

    {"id":"shift_subject_third","action":"把主体放到左三分之一","category":"composition","affects":["gaze_space"],"delta_hint":"视线方向留出空间","reason_template":"主体靠左，视线向右，画面才平衡","condition_hint":"gaze_space 不足且主体居中"},
    {"id":"shift_right_third","action":"把主体放到右三分之一","category":"composition","affects":["gaze_space"],"delta_hint":"视线方向留出空间","reason_template":"主体靠右，给左侧留白","condition_hint":"视线朝左"},
    {"id":"center_subject","action":"把主体放回正中","category":"composition","affects":["gaze_space"],"delta_hint":"对称稳定","reason_template":"对称构图适合强调庄重和产品","condition_hint":"产品/建筑"},
    {"id":"gaze_room","action":"在视线方向留出空间","category":"composition","affects":["gaze_space"],"delta_hint":"画面不再憋闷","reason_template":"人物看的方向要留白，这是最基本的规矩","condition_hint":"gaze_space < 目标下限"},
    {"id":"lower_horizon","action":"把地平线压到下三分之一","category":"composition","affects":["bg_complexity"],"delta_hint":"天空占更多","reason_template":"天空好看就让天多占一点","condition_hint":"风光"},

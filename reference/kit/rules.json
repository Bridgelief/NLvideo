{
  "version": "1.0",
  "updated": "2026-11-22",
  "owner": "队友B",
  "note": "规则库骨架 + 示例规则。队友B拉片后按此格式补充到覆盖80%常见场景。condition 字段与 suggest_engine.py 的 evaluate_condition 对应。",
  "operators": ["<", "<=", ">", ">=", "==", "in", "not_in"],
  "fields": ["subject_ratio", "bg_complexity", "light_angle", "gaze_space"],
  "rules": [
    {"id":"R001","condition":{"field":"subject_ratio","op":"<","value":0.30},"applies_to":["portrait_closeup","portrait_medium"],"action_id":"step_forward","reason":"主体占比偏低，观众看不清表情","priority":8},
    {"id":"R002","condition":{"field":"subject_ratio","op":">","value":0.60},"applies_to":["portrait_closeup","portrait_medium"],"action_id":"step_back","reason":"主体占比过高，画面太挤，退后能带出环境","priority":8},
    {"id":"R003","condition":{"field":"subject_ratio","op":"<","value":0.20},"applies_to":["emotional"],"action_id":"step_forward_close","reason":"情绪集中在脸上，需要更近","priority":7},
    {"id":"R004","condition":{"field":"subject_ratio","op":">","value":0.65},"applies_to":["product"],"action_id":"step_back","reason":"产品被裁切，退后才能看全","priority":8},
    {"id":"R005","condition":{"field":"subject_ratio","op":"<","value":0.35},"applies_to":["product"],"action_id":"step_forward","reason":"产品太小，细节看不清","priority":8},
    {"id":"R006","condition":{"field":"subject_ratio","op":">","value":0.25},"applies_to":["landscape"],"action_id":"zoom_out_context","reason":"风光主体太抢镜，环境交代不够","priority":7},

    {"id":"R010","condition":{"field":"bg_complexity","op":">","value":0.50},"applies_to":["all"],"action_id":"clean_background","reason":"背景杂物太多，会抢走注意力","priority":9},
    {"id":"R011","condition":{"field":"bg_complexity","op":">","value":0.35},"applies_to":["portrait_closeup"],"action_id":"longer_focal","reason":"长焦压缩背景，虚化后主体更突出","priority":8},
    {"id":"R012","condition":{"field":"bg_complexity","op":">","value":0.25},"applies_to":["product"],"action_id":"remove_clutter","reason":"产品画面要极简，杂物必须先清掉","priority":9},
    {"id":"R013","condition":{"field":"bg_complexity","op":">","value":0.40},"applies_to":["portrait_medium"],"action_id":"step_for_separation","reason":"让人离背景远一点，主体会立刻跳出来","priority":7},
    {"id":"R014","condition":{"field":"bg_complexity","op":">","value":0.30},"applies_to":["landscape"],"action_id":"clean_edge","reason":"画面边缘的树枝或路人会破坏整体","priority":6},
    {"id":"R015","condition":{"field":"bg_complexity","op":"<","value":0.10},"applies_to":["landscape"],"action_id":"frame_within_frame","reason":"背景太干净反而平，找个框增加层次","priority":5},

    {"id":"R020","condition":{"field":"light_angle","op":"not_in","value":["side","back"]},"applies_to":["portrait_closeup"],"action_id":"side_light","reason":"侧光能拍出轮廓和质感，比正面平光好看","priority":8},
    {"id":"R021","condition":{"field":"light_angle","op":"not_in","value":["side","front"]},"applies_to":["product"],"action_id":"side_light","reason":"产品需要侧面光才能显出质感","priority":8},
    {"id":"R022","condition":{"field":"light_angle","op":"not_in","value":["side","back","golden"]},"applies_to":["landscape"],"action_id":"golden_hour","reason":"风光靠光线吃饭，黄金时刻差别很大","priority":9},
    {"id":"R023","condition":{"field":"light_angle","op":"not_in","value":["back","side","low"]},"applies_to":["emotional"],"action_id":"back_light","reason":"逆光或侧光更能撑起情绪","priority":8},
    {"id":"R024","condition":{"field":"light_angle","op":"==","value":"front"},"applies_to":["portrait_medium"],"action_id":"avoid_backlight","reason":"面部在阴影里，换个角度让光打到脸上","priority":6},
    {"id":"R025","condition":{"field":"light_angle","op":"not_in","value":["side","front"]},"applies_to":["portrait_medium"],"action_id":"move_to_window","reason":"室内窗边有现成的柔光","priority":5},

    {"id":"R030","condition":{"field":"gaze_space","op":"<","value":0.25},"applies_to":["portrait_closeup"],"action_id":"gaze_room","reason":"人物看的方向要留白，这是最基本的规矩","priority":9},
    {"id":"R031","condition":{"field":"gaze_space","op":"<","value":0.30},"applies_to":["portrait_medium"],"action_id":"shift_subject_third","reason":"主体放到三分之一，视线方向自然留出空间","priority":8},
    {"id":"R032","condition":{"field":"gaze_space","op":">","value":0.60},"applies_to":["portrait_medium"],"action_id":"front_on","reason":"留白太多主体被挤到边上，回正中间","priority":6},
    {"id":"R033","condition":{"field":"gaze_space","op":">","value":0.65},"applies_to":["emotional"],"action_id":"dutch_angle","reason":"空旷感已经够强，倾斜画面强化不安情绪","priority":5},
    {"id":"R034","condition":{"field":"gaze_space","op":"<","value":0.35},"applies_to":["emotional"],"action_id":"gaze_room","reason":"情绪镜头更需要视线方向的呼吸感","priority":8},
    {"id":"R035","condition":{"field":"gaze_space","op":">","value":0.15},"applies_to":["product"],"action_id":"center_subject","reason":"产品居中更稳，留白不是重点","priority":6}
  ]
}
